{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "npm run start:dev",
    "start": "node dist/server/src/main.js",
    "start:dev": "nest start --watch --entryFile server/src/main",
    "start:debug": "nest start --debug --watch --entryFile server/src/main",
    "start:prod": "node dist/server/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:prepare": "prisma generate && prisma migrate deploy",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:auth": "pnpm run test:e2e -- test/e2e/auth.e2e-spec.ts",
    "test:e2e:services": "pnpm run test:e2e -- test/e2e/services.e2e-spec.ts",
    "test:e2e:availability": "pnpm run test:e2e -- test/e2e/availability.e2e-spec.ts",
    "test:e2e:appointments": "pnpm run test:e2e -- test/e2e/appointments.e2e-spec.ts",
    "test:e2e:public": "pnpm run test:e2e -- test/e2e/public.e2e-spec.ts",
    "test:e2e:profile": "pnpm run test:e2e -- test/e2e/profile.e2e-spec.ts",
    "test:e2e:regression": "pnpm run test:e2e -- test/e2e/regression.e2e-spec.ts",
    "test:e2e:full": "pnpm run test:e2e:prepare && pnpm run test:e2e",
    "test:unit": "jest --testPathPatterns=test/unit",
    "test:integration": "jest --testPathPatterns=test/integration"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^6.15.0",
    "@saas/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "6.15.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
