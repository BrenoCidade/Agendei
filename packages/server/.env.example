# Database — Supabase
# URL do pooler (porta 6543) — usada pelo app em runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10"
# URL direta (porta 5432) — usada só pelo Prisma para migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
# Gere um valor seguro com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server
PORT=3333
NODE_ENV=development

# Frontend (CORS)
FRONTEND_URL=http://localhost:8080
